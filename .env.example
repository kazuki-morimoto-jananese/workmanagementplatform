HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
NODE_ENV=development
# Optional: restrict member email addresses to your Workspace domain.
ALLOWED_EMAIL_DOMAIN=
# Required for first-time setup when NODE_ENV=production. Use a long random value.
SETUP_TOKEN=
# Set COOKIE_SECURE=true behind an HTTPS reverse proxy in production.
COOKIE_SECURE=false
DATA_DIR=./data

# Private Google Sheets. Share your spreadsheet with the service account email.
GOOGLE_SERVICE_ACCOUNT_FILE=
# Server-side credentials only. Never prefix these with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_AUTO_SUMMARY=false
# The same service account can read shared Google Docs when Drive API is enabled.
# Daily per-workspace request caps; failures also count. Google quota/billing is separate.
GEMINI_DAILY_EXTRACTIONS=20
GEMINI_DAILY_SUMMARIES=20
