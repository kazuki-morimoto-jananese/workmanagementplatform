{
  "name": "worknest",
  "version": "2.15.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "tsc --noEmit",
    "check:publish": "node scripts/check-publish.mjs",
    "test:browser": "node .browser-check.mjs --sales",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "demo:sales": "node --env-file-if-exists=.env scripts/seed-sales-demo.mjs",
    "preview": "node --env-file-if-exists=.env server/index.mjs",
    "restore": "node scripts/restore.mjs",
    "prepare:company": "node scripts/prepare-company.mjs",
    "dev:cloud": "wrangler dev",
    "build:cloud": "npm run build && wrangler deploy --dry-run --outdir artifacts/cloud-build",
    "deploy:cloud": "npm run build && wrangler deploy",
    "test:cloud": "node .browser-check.mjs --sales --cloud",
    "restore:export": "node scripts/restore-export.mjs",
    "connect:cloud": "node scripts/connect-cloud.mjs"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "read-excel-file": "^9.3.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "fflate": "^0.8.3",
    "prettier": "^3.9.6",
    "typescript": "^5.7.0",
    "vite": "^8.2.2",
    "wrangler": "^4.129.0"
  }
}
